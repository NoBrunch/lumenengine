#!/usr/bin/env bash
# Configure the dedicated Lumen PC side of Lumen Link.
# Status is read-only. Network and credential writes require --apply.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LINK_ROOT="${PROJECT_ROOT}/state/lumen-link"
LINK_CONFIG="${LINK_ROOT}/config.json"
SECRET_FILE="${LINK_ROOT}/secret"
CONNECTION_NAME="lumen-link"
INTERFACE="enp1s0"
LUMEN_ADDRESS="192.168.50.2/24"
ENDPOINT="http://192.168.50.1:8765"

usage() {
    cat <<'EOF'
Usage: scripts/lumen-link COMMAND [OPTIONS]

Commands:
  status             Read-only local configuration/network report (default)
  network            Dry-run the direct Ethernet setup
  network --apply    Configure 192.168.50.2/24 without gateway or DNS
  pair               Dry-run local HMAC pairing
  pair --apply       Prompt privately for the WSL HMAC secret
  pair --apply --secret-source PATH
                     Copy a secret from local/removable media without printing
  setup              Dry-run network, config and pairing operations
  setup --apply [--secret-source PATH]
                     Apply the complete Lumen-PC setup
  test                Authenticated read-only health check to the worker

Options:
  --apply             Authorize local/network mutations
  --interface NAME    Wired device (default: enp1s0)
  --secret-source PATH
                     Existing local/removable-media secret transfer file

No command uploads data to Git or shares Lumen's SQLite database.
EOF
}

shell_join() {
    local value
    printf 'DRY-RUN:'
    for value in "$@"; do printf ' %q' "$value"; done
    printf '\n'
}

connection_exists() {
    nmcli -t -f NAME connection show 2>/dev/null | grep -Fqx "$CONNECTION_NAME"
}

status() {
    local active_connection=""
    active_connection="$(nmcli -g GENERAL.CONNECTION device show "$INTERFACE" 2>/dev/null || true)"
    printf 'Lumen Link — live-computer status\n'
    printf '  interface              %s\n' "$INTERFACE"
    printf '  connection profile     %s\n' "$(connection_exists && printf 'ready' || printf 'missing')"
    printf '  expected local address %s\n' "$LUMEN_ADDRESS"
    printf '  active wired profile   %s\n' "${active_connection:---}"
    printf '  worker endpoint        %s\n' "$ENDPOINT"
    printf '  local config           %s\n' "$([[ -f "$LINK_CONFIG" ]] && printf 'ready' || printf 'missing')"
    if [[ -f "$SECRET_FILE" ]]; then
        printf '  HMAC secret            ready (mode %s; value not displayed)\n' "$(stat -c '%a' "$SECRET_FILE")"
    else
        printf '  HMAC secret            missing\n'
    fi
    if command -v ip >/dev/null 2>&1; then
        ip -brief -4 address show dev "$INTERFACE" 2>/dev/null || true
        printf '  default route          '
        ip -4 route show default | head -1 || true
    fi
}

configure_network() {
    if [[ "$APPLY" == "0" ]]; then
        if connection_exists; then
            shell_join sudo nmcli connection modify "$CONNECTION_NAME" \
                connection.interface-name "$INTERFACE" \
                ipv4.method manual ipv4.addresses "$LUMEN_ADDRESS" \
                ipv4.gateway "" ipv4.dns "" ipv4.never-default yes \
                ipv6.method disabled connection.autoconnect yes \
                connection.autoconnect-priority 100 \
                connection.autoconnect-retries 0
        else
            shell_join sudo nmcli connection add type ethernet \
                ifname "$INTERFACE" con-name "$CONNECTION_NAME" \
                ipv4.method manual ipv4.addresses "$LUMEN_ADDRESS" \
                ipv4.never-default yes ipv6.method disabled
            shell_join sudo nmcli connection modify "$CONNECTION_NAME" \
                ipv4.gateway "" ipv4.dns "" connection.autoconnect yes \
                connection.autoconnect-priority 100 \
                connection.autoconnect-retries 0
        fi
        shell_join sudo nmcli connection up "$CONNECTION_NAME"
        return
    fi
    if connection_exists; then
        sudo nmcli connection modify "$CONNECTION_NAME" \
            connection.interface-name "$INTERFACE" \
            ipv4.method manual ipv4.addresses "$LUMEN_ADDRESS" \
            ipv4.gateway "" ipv4.dns "" ipv4.never-default yes \
            ipv6.method disabled connection.autoconnect yes \
            connection.autoconnect-priority 100 \
            connection.autoconnect-retries 0
    else
        sudo nmcli connection add type ethernet \
            ifname "$INTERFACE" con-name "$CONNECTION_NAME" \
            ipv4.method manual ipv4.addresses "$LUMEN_ADDRESS" \
            ipv4.never-default yes ipv6.method disabled
        sudo nmcli connection modify "$CONNECTION_NAME" \
            ipv4.gateway "" ipv4.dns "" connection.autoconnect yes \
            connection.autoconnect-priority 100 \
            connection.autoconnect-retries 0
    fi
    sudo nmcli connection up "$CONNECTION_NAME"
    if ip -4 route show default | grep -Fq "dev ${INTERFACE}"; then
        printf 'Default route unexpectedly moved to %s; disabling the link.\n' "$INTERFACE" >&2
        sudo nmcli connection down "$CONNECTION_NAME"
        return 1
    fi
}

write_config() {
    if [[ "$APPLY" == "0" ]]; then
        shell_join mkdir -p "$LINK_ROOT"
        printf 'DRY-RUN: write disabled Lumen Link config at %q (mode 600)\n' "$LINK_CONFIG"
        return
    fi
    install -d -m 700 "$LINK_ROOT"
    python3 - "$LINK_CONFIG" <<'PY'
import json
from pathlib import Path
import sys

path = Path(sys.argv[1])
current = {}
if path.is_file():
    current = json.loads(path.read_text(encoding="utf-8"))
current.update(
    {
        "schema": "lumen.link.config.v1",
        "endpoint": "http://192.168.50.1:8765",
        "secret_file": "secret",
    }
)
current.setdefault("enabled", False)
current.setdefault("paused", False)
partial = path.with_suffix(".json.partial")
partial.write_text(json.dumps(current, indent=2, sort_keys=True) + "\n", encoding="utf-8")
partial.chmod(0o600)
partial.replace(path)
PY
    chmod 600 "$LINK_CONFIG"
}

pair_secret() {
    local source="$1"
    if [[ "$APPLY" == "0" ]]; then
        printf 'DRY-RUN: install a locally supplied HMAC secret at %q (mode 600; value never displayed)\n' "$SECRET_FILE"
        return
    fi
    install -d -m 700 "$LINK_ROOT"
    local temporary
    temporary="$(mktemp "${LINK_ROOT}/.secret.XXXXXX")"
    chmod 600 "$temporary"
    if [[ -n "$source" ]]; then
        [[ -f "$source" ]] || { printf 'Secret source not found: %s\n' "$source" >&2; rm -f "$temporary"; return 2; }
        install -m 600 "$source" "$temporary"
    else
        [[ -t 0 ]] || { printf 'Interactive pairing requires a terminal or --secret-source PATH.\n' >&2; rm -f "$temporary"; return 2; }
        local entered
        read -r -s -p 'Paste the one-line WSL Lumen Link secret: ' entered
        printf '\n'
        printf '%s\n' "$entered" > "$temporary"
        unset entered
    fi
    local secret_length
    secret_length="$(tr -d '\r\n' < "$temporary" | wc -c)"
    if (( secret_length < 32 )); then
        rm -f "$temporary"
        printf 'Secret rejected: it must contain at least 32 bytes.\n' >&2
        return 1
    fi
    tr -d '\r\n' < "$temporary" > "${temporary}.normalized"
    printf '\n' >> "${temporary}.normalized"
    chmod 600 "${temporary}.normalized"
    mv -f "${temporary}.normalized" "$SECRET_FILE"
    rm -f "$temporary"
}

test_endpoint() {
    [[ -f "$LINK_CONFIG" && -f "$SECRET_FILE" ]] || {
        printf 'Pair and configure Lumen Link before testing.\n' >&2
        return 1
    }
    PYTHONPATH="${PROJECT_ROOT}/src" python3 - "$LINK_CONFIG" <<'PY'
from pathlib import Path
import sys

from lumen_engine.link import LinkClient, LinkConfiguration

configuration = LinkConfiguration.load(Path(sys.argv[1]))
if not configuration.secret:
    raise SystemExit("Lumen Link secret is unavailable")
health = LinkClient(configuration.endpoint, configuration.secret).health()
node = health.get("node") or {}
capabilities = health.get("capabilities") or {}
expected = ["teacher.edmformer", "teacher.songformer", "student.train"]
supported = capabilities.get("supported_job_types") or []
gated = capabilities.get("gated_job_types") or {}
print("Authenticated Lumen Link connection succeeded.")
print(f"  node: {node.get('hostname') or node.get('name') or 'threadripper-wsl'}")
print(f"  supported jobs: {', '.join(supported) or 'none'}")
missing = [name for name in expected if name not in supported]
for name in missing:
    print(f"  gated: {name}: {gated.get(name) or 'not advertised'}")
if missing:
    raise SystemExit(
        "The worker authenticated but is not ready for every Lumen Link job"
    )
PY
}

COMMAND="${1:-status}"
if (( $# )); then shift; fi
APPLY=0
SECRET_SOURCE=""
while (( $# )); do
    case "$1" in
        --apply) APPLY=1 ;;
        --interface) shift; INTERFACE="${1:?--interface requires a device}" ;;
        --secret-source) shift; SECRET_SOURCE="${1:?--secret-source requires a path}" ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

case "$COMMAND" in
    status) status ;;
    network) configure_network ;;
    pair) write_config; pair_secret "$SECRET_SOURCE" ;;
    setup) configure_network; write_config; pair_secret "$SECRET_SOURCE" ;;
    test) test_endpoint ;;
    -h|--help|help) usage ;;
    *) printf 'Unknown command: %s\n' "$COMMAND" >&2; usage >&2; exit 2 ;;
esac
