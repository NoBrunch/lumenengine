#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

if curl --silent --fail --max-time 1 \
  "http://127.0.0.1:4042/api/status" >/dev/null 2>&1; then
  exec xdg-open "http://127.0.0.1:4042/"
fi

exec "${PROJECT_DIR}/scripts/lumen" ui --open "$@"
